                    "name": "punctuation.separator.dictionary.pair.smithy"
                },
                {
                    "match": "[^\\s\\}]",
                    "name": "invalid.illegal.inline-map.smithy"
                }
            ]
        },
        "string_key": {
            "patterns": [
                {
                    "include": "#identifier_key"
                },
                {
                    "include": "#dquote_key"
                }
            ]
        },
        "identifier_key": {
            "name": "support.type.property-name.smithy",
            "match": "(?<![A-Za-z0-9_.#$])[A-Za-z_][A-Za-z0-9_]*(?:[.#$][A-Za-z_][A-Za-z0-9_]*)*(?=\\s*:)"
        },
        "dquote_key": {
            "name": "support.type.property-name.smithy",
            "match": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)"
        },
        "string": {
            "patterns": [
                {
                    "include": "#tagged_literal"
                },
                {
                    "include": "#textblock"
                },
                {
                    "include": "#dquote"
                },
                {
                    "include": "#shapeid"
                }
            ]
        },
        "tagged_literal": {
            "comment": "IDL 2.1 tagged string literals. The tag set is closed to re, b, hex and timestamp, and a quote must follow the tag, which is what keeps shape ids such as `com.example#b` from being mistaken for one. The bodies are raw, so the only backslash the lexer acts on is the one protecting a quote; every other backslash pair is consumed without being marked an escape, which keeps regex atoms like \\d plain.",
            "patterns": [
                {
                    "name": "string.quoted.double.raw.smithy",
                    "begin": "(#)(timestamp|hex|re|b)(?![A-Za-z0-9_])[ \\t]*(\"\"\")",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.smithy"
                        },
                        "2": {
                            "name": "storage.type.tag.smithy"
                        },
                        "3": {
                            "name": "punctuation.definition.string.begin.smithy"
                        }
                    },
                    "end": "\"\"\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.smithy"
                        }
                    },
                    "patterns": [
                        {
                            "match": "\\\\\"",
                            "name": "constant.character.escape.smithy"
                        },
                        {
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.raw.smithy",
                    "begin": "(#)(timestamp|hex|re|b)(?![A-Za-z0-9_])[ \\t]*(\")",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.smithy"
                        },
                        "2": {
                            "name": "storage.type.tag.smithy"
                        },
                        "3": {
                            "name": "punctuation.definition.string.begin.smithy"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.smithy"
                        }
                    },
                    "patterns": [
                        {
                            "match": "\\\\\"",
                            "name": "constant.character.escape.smithy"
                        },
                        {
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "textblock": {
            "name": "string.quoted.double.smithy",
            "begin": "\"\"\"",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.smithy"
                }
            },
            "end": "\"\"\"",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.smithy"
                }
            },
            "patterns": [
                {
                    "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})",
                    "name": "constant.character.escape.smithy"
                },
                {
                    "match": "\\\\$",
                    "name": "constant.character.escape.smithy"
                },
                {
                    "match": "\\\\.",
                    "name": "invalid.illegal.escape.smithy"
                }
            ]
        },
        "dquote": {
            "name": "string.quoted.double.smithy",
            "begin": "\"",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.smithy"
                }
            },
            "end": "\"",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.smithy"
                }
            },
            "patterns": [
                {
                    "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})",
                    "name": "constant.character.escape.smithy"
                },
                {
                    "match": "\\\\$",
                    "name": "constant.character.escape.smithy"
                },
                {
                    "match": "\\\\.",
                    "name": "invalid.illegal.escape.smithy"
                }
            ]
        },
        "shapeid": {
            "name": "entity.name.type.smithy",
            "match": "[A-Za-z_][A-Za-z0-9_\\.#$]*"
        },
        "elided_target": {
            "match": "(\\$)([A-Za-z0-9_\\.#$]+)",
            "captures": {
                "1": {
                    "name": "keyword.statement.elision.smithy"
                },
                "2": {
                    "name": "support.type.property-name.smithy"
                }
            }
        }
    }
}
