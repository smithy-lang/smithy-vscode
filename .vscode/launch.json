// A launch configuration that launches the extension inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension - Test Suite",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "compile",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionTestsPath=${workspaceFolder}/out/tests/helper",
                "${workspaceFolder}/test-fixtures/${input:suite}"
            ],
            "env": { "SUITE_DIR": "${workspaceFolder}/out/tests/${input:suite}" },
            "outFiles": ["${workspaceFolder}/out/**/*.js"]
        }
    ],
    "inputs": [
        {
            "id": "suite",
            "type": "pickString",
            "description": "Test suite to run",
            "options": [
                { "label": "suite1 - Language registration", "value": "suite1" },
                { "label": "suite2 - Diagnostics", "value": "suite2" },
                { "label": "suite3 - Selectors", "value": "suite3" },
                { "label": "suite4 - User-specific root", "value": "suite4" },
                { "label": "suite5 - Formatter", "value": "suite5" },
                { "label": "suite6 - Startup", "value": "suite6" }
            ],
            "default": "suite1"
        }
    ]
}
