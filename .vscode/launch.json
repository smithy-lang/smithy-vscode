// A launch configuration that launches the extension inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension - Test Suite",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "bundle",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionTestsPath=${workspaceFolder}/tests/helper.ts",
                "${workspaceFolder}/tests/${input:suite}/workspace"
            ],
            "env": { "SUITE_DIRS": "${workspaceFolder}/tests/${input:suite}" },
            "outFiles": ["${workspaceFolder}/out/**/*.js"],
            // The bundle's source map can load after activate() has already run, so wait for it
            // before running the script. Otherwise breakpoints in src/*.ts may not bind.
            "pauseForSourceMap": true
        }
    ],
    "inputs": [
        {
            "id": "suite",
            "type": "pickString",
            "description": "Test suite to run",
            "options": [
                "activation",
                "diagnostics",
                "formatter",
                "java-home",
                "java-home-missing",
                "selector",
                "startup",
                "subdirectory-project"
            ],
            "default": "startup"
        }
    ]
}
